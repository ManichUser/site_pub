PORT=3000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=pub_app
DB_PASSWORD=REPLACE_ME_STRONG_PASSWORD
DB_NAME=pub_rewards

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=REPLACE_ME_STRONG_PASSWORD

# Générer avec : npm run generate:secrets (ou openssl rand -base64 48)
JWT_SECRET=REPLACE_ME_RANDOM_SECRET_MIN_32_CHARS
JWT_EXPIRES_IN=7d

# Origines autorisées pour CORS, séparées par des virgules (jamais '*')
ALLOWED_ORIGINS=http://localhost:3001,http://localhost:19006

# Barème métier par défaut (surchargeable via le back-office plus tard)
VIDEOS_REQUIRED_DEFAULT=20
GAIN_AMOUNT_DEFAULT=500
AFFILIATION_COMMISSION_RATE=0.6
MIN_WITHDRAWAL_AMOUNT=1000
DAILY_GAIN_CAP_PER_USER=5000
